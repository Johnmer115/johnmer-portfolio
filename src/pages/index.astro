];
const tools = [
  "Laravel",
  "PHP",
  "MySQL",
  "JavaScript",
  "jQuery",
  "Bootstrap 5",
  "Blade",
  "Chart.js",
  "CodeIgniter",
  ".NET WinForms",
  "DataTables",
  "Git / GitHub",
  "Canvas API",
];
const projects = [
  {
    id: "01",
    title: "AU SARF Tracer",
    role: "Co-developer",
