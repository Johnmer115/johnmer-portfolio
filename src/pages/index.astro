    tech: "Laravel · MySQL · Blade · Bootstrap 5",
    link: "https://github.com/Johnmer115/Tracer",
  },
  {
    id: "02",
    title: "WeConnect — Brgy 409",
    role: "Co-developer",
    text: "A barangay management system for Barangay 409, Manila, covering a certification module, a dashboard with an announcement banner and staff/timeline info, and a finance management module added at your supervisor's request — built with role-based middleware and PDF generation via laravel-dompdf.",
    tech: "Laravel · MySQL · Bootstrap 5 · Chart.js",
    link: "https://github.com/Johnmer115/WeConnect_Brgy409",
  },
  {
    id: "03",
    title: "AU AIS",
