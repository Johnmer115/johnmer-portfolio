    text: "An Academic Information System for Admin, Enrollment Officer, and Student roles, where you focused on QA — testing role-based access control across the three roles, the grade-import workflow, and the student-facing portal.",
    tech: "Laravel · MySQL · Blade",
    link: "https://github.com/Jerdzdidan/AU-AIS",
  },
  {
    id: "04",
    title: "AMGC Pharmacy Inventory",
    role: "Contributor / QA",
    text: "A desktop POS and inventory management system for a pharmacy, handling purchase orders, supplier records, refunds, and a sales dashboard on a MySQL backend accessed through a pooled ADO.NET data layer.",
    tech: "C# · .NET WinForms · MySQL · ADO.NET",
    link: "https://github.com/rhennmarc/CS311-Inventory-Management-System",
  },
  {
    id: "05",
    title: "Maayo Company",
    role: "Front-end Developer",
    text: "Digitized Maayo Company's manual shipment booking process into a web system with a customer-facing booking flow and an admin panel to manage incoming bookings, built during your pre-OJT in 2nd year.",
    tech: "CodeIgniter · PHP · JavaScript · MySQL · Bootstrap",
  },
  {
    id: "06",
    title: "Dress & Stop",
    role: "Solo Developer",
    text: "A website for a local tailoring shop combining a clothing catalog — casual dresses, formal attire, school uniforms, blazers, and more — with an appointment booking flow for fittings and pickups. I made it in my 1st year.",
